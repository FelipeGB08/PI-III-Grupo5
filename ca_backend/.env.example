# Servidor
PORT=3000
NODE_ENV=development

# Swagger UI: habilitado automaticamente fora de producao.
# Defina true/false para sobrescrever o comportamento padrao.
ENABLE_API_DOCS=
# URL base exibida pelo Swagger. O prefixo /api/v1 é acrescentado automaticamente.
API_DOCS_SERVER_URL=

# Monitoramento de erros no Sentry (opcional). Deixe vazio em desenvolvimento.
SENTRY_DSN=
SENTRY_ENVIRONMENT=

# Origens permitidas pelo CORS, separadas por virgula e com protocolo.
# Exemplo: http://localhost:56000,https://app.exemplo.com
ALLOWED_ORIGINS=http://localhost:56000

# JWT
# Troque por uma chave grande antes de qualquer demonstração fora da máquina local.
JWT_SECRET=troque_por_uma_chave_grande
# Em produção, use pelo menos 32 caracteres aleatórios; placeholders e valores repetitivos bloqueiam o boot.

# PostgreSQL
# Use DATABASE_URL em deploy (preferível no Render). Quando ela estiver preenchida,
# DB_HOST, DB_PORT, DB_USER, DB_PASSWORD e DB_NAME são ignoradas.
DATABASE_URL=
# Alternativa para banco local: informe todas as variáveis abaixo.
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=123456
DB_NAME=conecta_amauc

# Diretório local para imagens enviadas. Se vazio, usa ca_backend/uploads.
UPLOADS_DIR=
# Diretório privado para documentos de verificacao. Nunca é servido pela rota /uploads.
VERIFICATION_DOCUMENTS_DIR=

# Login com Google
# Web Client ID: audience aceito pelo backend e usado como GOOGLE_SERVER_CLIENT_ID no Flutter nativo.
GOOGLE_CLIENT_ID=seu_google_oauth_client_id

# Frontend usado para montar links de magic link/reset
FRONTEND_URL=http://localhost:56000

# SMTP real para magic link e reset de senha
# Sem SMTP configurado, o backend mantém o fluxo local/dev documentado.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=seu_email@gmail.com
SMTP_PASS=sua_senha_de_app
MAIL_FROM="Conecta AMAUC <seu_email@gmail.com>"

# Rate limit das rotas sensíveis de autenticação
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX=10
REGISTER_RATE_LIMIT_WINDOW_MS=3600000
REGISTER_RATE_LIMIT_MAX=5

# Rate limits por usuário autenticado para ações de maior risco.
# Mantenha os valores generosos para não interferir no uso normal do app.
SOLICITACAO_RATE_LIMIT_WINDOW_MS=3600000
SOLICITACAO_RATE_LIMIT_MAX=20
CHAT_RATE_LIMIT_WINDOW_MS=60000
CHAT_RATE_LIMIT_MAX=60
UPLOAD_RATE_LIMIT_WINDOW_MS=3600000
UPLOAD_RATE_LIMIT_MAX=30

# Firebase Cloud Messaging via Firebase Admin SDK
# Opção 1: use GOOGLE_APPLICATION_CREDENTIALS apontando para o JSON da service account.
GOOGLE_APPLICATION_CREDENTIALS=

# Opção 2: informe os campos da service account diretamente por variável de ambiente.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

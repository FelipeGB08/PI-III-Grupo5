# Servidor
PORT=3000
NODE_ENV=development

# Swagger UI: habilitado automaticamente fora de producao.
# Defina true/false para sobrescrever o comportamento padrao.
ENABLE_API_DOCS=

# Origens permitidas pelo CORS, separadas por virgula e com protocolo.
# Exemplo: http://localhost:56000,https://app.exemplo.com
ALLOWED_ORIGINS=http://localhost:56000

# JWT
# Troque por uma chave grande antes de qualquer demonstração fora da máquina local.
JWT_SECRET=troque_por_uma_chave_grande

# PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=123456
DB_NAME=conecta_amauc

# OAuth social login
# Necessário apenas para login social real.
GOOGLE_CLIENT_ID=seu_google_oauth_client_id
APPLE_CLIENT_ID=seu_apple_services_id_ou_bundle_id
GITHUB_CLIENT_ID=seu_github_oauth_client_id
GITHUB_CLIENT_SECRET=seu_github_oauth_client_secret

# Frontend usado para montar links de magic link/reset
FRONTEND_URL=http://localhost:56000

# SMTP real para magic link e reset de senha
# Sem SMTP configurado, o backend mantém o fluxo local/dev documentado.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=seu_email@gmail.com
SMTP_PASS=sua_senha_de_app
MAIL_FROM="Conecta AMAUC <seu_email@gmail.com>"

# Rate limit das rotas sensíveis de autenticação
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX=10
REGISTER_RATE_LIMIT_WINDOW_MS=3600000
REGISTER_RATE_LIMIT_MAX=5

# Firebase Cloud Messaging via Firebase Admin SDK
# Opção 1: use GOOGLE_APPLICATION_CREDENTIALS apontando para o JSON da service account.
GOOGLE_APPLICATION_CREDENTIALS=

# Opção 2: informe os campos da service account diretamente por variável de ambiente.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Alternativa para deploy:
# DATABASE_URL=postgres://usuario:senha@host:5432/conecta_amauc
